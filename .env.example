# Sign-up storage. Leave empty in development: sign-ups are then written to .data/signups.jsonl.
# In production set both (Supabase > Project settings > API). The publishable (anon) key is enough:
# the table only allows inserts through it (supabase/schema.sql).
SUPABASE_URL=
SUPABASE_KEY=
# optional, defaults to bizmo_launch_signups
SUPABASE_TABLE=
